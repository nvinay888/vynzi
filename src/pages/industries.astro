---
/* Industries, v5 — the whole page is one explorer: hero headline, then a side-tab panel per sector holding the full
   old-site copy (context, what we provide, every service paragraph, the practices that deliver it). No long scroll. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SideTabs from '../components/SideTabs.astro';
import Badge from '../components/Badge.astro';
import CtaBand from '../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { industries } from '../content/industries';
import { sectors as sectorMeta, practices as practiceMeta } from '../data/site';
const iconFor = (slug: string) => sectorMeta.find((s) => s.slug === slug)?.icon ?? 'ph:buildings-duotone';
const practice = (slug: string) => practiceMeta.find((p) => p.slug === slug);
const tabs = industries.sectors.map((s) => ({ label: s.name, sub: s.services.length ? `${s.services.length} service areas` : 'Talk to us', icon: iconFor(s.slug) }));
---
<BaseLayout title="Industries" description={industries.hero.text}>
  <PageHero eyebrow={industries.hero.eyebrow} title="Finance, technology and ESG support" titleDim="for seven sectors" text={industries.hero.text.split('. ').slice(0, 1).join('. ') + '.'}>
    <div slot="below">
      <SideTabs tabs={tabs} id="sectors" label="Sectors">
        {industries.sectors.map((s) => (
          <div data-panel data-slug={s.slug}>
            <div class="sh"><span class="ring ring--blue"><Icon name={iconFor(s.slug)} /></span><h2>{s.name}</h2></div>
            <div class="intro">
              <p class="ctx">{s.context}</p>
              <div class="provide"><p class="eyebrow">What we provide</p><p>{s.provide}</p></div>
            </div>
            {s.services.length > 0 && (
              <ul class="svc">
                {s.services.map((f) => <li><strong>{f.title}</strong><p>{f.text}</p></li>)}
              </ul>
            )}
            <div class="foot">
              <div class="pr"><span class="small muted">Delivered by</span>{s.practices.map((slug) => { const p = practice(slug); return p ? <a href={`/services/${p.slug}`} class="plink"><Badge tone={p.accent}>{p.nav}</Badge></a> : null; })}</div>
              <a href="/contact" class="arrow arrow--blue">{s.slug === 'other' ? 'Discuss your business' : `Discuss your ${s.name.toLowerCase()} business`}<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            </div>
          </div>
        ))}
      </SideTabs>
    </div>
  </PageHero>

  <CtaBand />
</BaseLayout>

<style>
  .sh { display: flex; align-items: center; gap: 14px; }
  .sh h2 { font-size: clamp(24px, 2.4vw, 32px); }
  .intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-top: 20px; align-items: start; }
  .ctx { font-size: 16px; line-height: 1.65; color: var(--graphite); }
  .provide { padding: 16px 18px; border-radius: 12px; background: var(--surface-base); }
  .provide p + p { margin-top: 6px; font-size: 14.5px; font-weight: 500; line-height: 1.5; color: var(--ink); }
  .svc { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 22px; }
  .svc li { padding: 18px 20px; border-radius: 14px; background: var(--surface); box-shadow: rgba(11,31,77,.08) 0 0 0 1px; }
  .svc strong { display: block; font-weight: 600; font-size: 15.5px; color: var(--ink); }
  .svc p { margin-top: 6px; font-size: 14px; line-height: 1.6; color: var(--slate); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-top: 22px; }
  .pr { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .plink:hover :global(.badge) { background: var(--ink-fill); color: #fff; }
  .foot .arrow { font-size: 14px; }
  @media (max-width: 760px) { .intro, .svc { grid-template-columns: 1fr; } }
</style>
