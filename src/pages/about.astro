---
/* About, v5 — hero with the overlap diagram, then one explorer (blueprint slide 11: the story, approach, why clients
   engage, values) instead of four stacked sections. Leadership appears as a tab only once real profiles exist. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SideTabs from '../components/SideTabs.astro';
import OverlapDiagram from '../components/art/OverlapDiagram.astro';
import CtaBand from '../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { about } from '../content/about';
const whyIcons = ['ph:trend-up-duotone', 'ph:eye-duotone', 'ph:shield-check-duotone'];
const approachIcons = ['ph:hand-palm-duotone', 'ph:ruler-duotone', 'ph:cpu-duotone', 'ph:target-duotone'];
const valueItems = [
  { title: 'Ethical standards', text: 'Every recommendation we make is in your best interest.', icon: 'ph:scales-duotone' },
  { title: 'Open communication', text: 'The information and insight you need to decide with confidence.', icon: 'ph:chats-circle-duotone' },
  { title: 'Lasting relationships', text: 'Trusted advisers, not just accountants, at every step.', icon: 'ph:handshake-duotone' },
];
const showLeadership = about.leadership.people.length > 0;
const tabs = [
  { label: 'Who we are', sub: 'The story', icon: 'ph:book-open-text-duotone' },
  { label: 'Our approach', sub: 'Four principles', icon: 'ph:compass-duotone' },
  { label: 'Why clients engage us', sub: 'Three reasons', icon: 'ph:handshake-duotone' },
  { label: 'What we stand for', sub: 'Our values', icon: 'ph:scales-duotone' },
  ...(showLeadership ? [{ label: 'Leadership', sub: 'The team', icon: 'ph:users-three-duotone' }] : []),
];
---
<BaseLayout title="About" description={about.hero.text}>
  <PageHero eyebrow={about.hero.eyebrow} title="A partner designed around" titleDim="the way modern businesses operate (Financially and Sustainably)" text={about.hero.text}>
    <div slot="below"><OverlapDiagram /></div>
  </PageHero>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="About Vynzi" title="The firm" titleDim="behind the work" text="Who we are, how we work and what we stand for, in one place." />
      <SideTabs tabs={tabs} id="about" label="About Vynzi">
        <div data-panel data-slug="who-we-are">
          <div class="story">
            <div class="story__card"><p class="eyebrow story__eyebrow">The story</p><p class="story__line">A finance partner designed around the way modern businesses operate: Finance, Data, Technology and Sustainability always overlap.</p></div>
            <div class="story__text">{about.story.paragraphs.map((p) => <p>{p}</p>)}</div>
          </div>
        </div>

        <div data-panel data-slug="our-approach">
          <h3 class="pt">{about.approach.title}</h3>
          <ul class="grid4">{about.approach.items.map((a, i) => <li><span class="ring ring--blue"><Icon name={approachIcons[i]} /></span><strong>{a.title}</strong><p>{a.text}</p></li>)}</ul>
        </div>

        <div data-panel data-slug="why-clients-engage-us">
          <h3 class="pt">{about.why.title}</h3>
          <ul class="grid3">{about.why.items.map((w, i) => <li><span class="ring ring--blue"><Icon name={whyIcons[i]} /></span><strong>{w.title}</strong><p>{w.text}</p></li>)}</ul>
        </div>

        <div data-panel data-slug="what-we-stand-for">
          <h3 class="pt">{about.values.title}</h3>
          <p class="pi">{about.values.text}</p>
          <ul class="grid3">{valueItems.map((v) => <li><span class="ring ring--blue"><Icon name={v.icon} /></span><strong>{v.title}</strong><p>{v.text}</p></li>)}</ul>
        </div>

        {showLeadership && (
          <div data-panel data-slug="leadership">
            <h3 class="pt">{about.leadership.title}</h3>
            <ul class="grid3">{about.leadership.people.map((p) => <li>{p.photo && <img src={p.photo} alt={p.name} width="96" height="96" />}<strong>{p.name}</strong><p>{p.role}</p><p>{p.bio}</p></li>)}</ul>
          </div>
        )}
      </SideTabs>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .story { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 24px; align-items: start; }
  .story__card { padding: 28px; border-radius: 16px; background: var(--gradient-dark-card); color: #fff; }
  .story__eyebrow { color: var(--gold); }
  .story__line { margin-top: 14px; font-family: var(--font-display); font-weight: 500; font-size: clamp(20px, 2vw, 24px); line-height: 1.3; }
  .story__text p { color: var(--graphite); font-size: 15.5px; line-height: 1.7; }
  .story__text p + p { margin-top: 14px; }
  .pt { font-size: clamp(22px, 2.2vw, 28px); }
  .pi { margin-top: 12px; color: var(--graphite); line-height: 1.65; max-width: 70ch; }
  .grid4, .grid3 { display: grid; gap: 12px; margin-top: 22px; }
  .grid4 { grid-template-columns: repeat(2, 1fr); }
  .grid3 { grid-template-columns: repeat(3, 1fr); }
  .grid4 li, .grid3 li { display: flex; flex-direction: column; gap: 10px; padding: 22px; border-radius: 14px; background: var(--surface); box-shadow: rgba(11,31,77,.08) 0 0 0 1px; }
  .grid4 strong, .grid3 strong { margin-top: 6px; font-family: var(--font-display); font-weight: 500; font-size: 21px; letter-spacing: -0.01em; color: var(--ink); }
  .grid4 p, .grid3 p { font-size: 14.5px; line-height: 1.55; color: var(--slate); }
  @media (max-width: 860px) { .story, .grid3 { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .grid4 { grid-template-columns: 1fr; } }
</style>
