---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import LedgerList from '../components/LedgerList.astro';
import WhyGrid from '../components/WhyGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OverlapDiagram from '../components/art/OverlapDiagram.astro';
import Badge from '../components/Badge.astro';
import CtaBand from '../components/CtaBand.astro';
import NetworkGraph from '../components/art/NetworkGraph.astro';
import { Icon } from 'astro-icon/components';
import { about } from '../content/about';
const whyIcons = ['ph:trend-up-duotone', 'ph:eye-duotone', 'ph:shield-check-duotone'];
const showLeadership = about.leadership.people.length > 0;
---
<BaseLayout title="About" description={about.hero.text}>
  <PageHero eyebrow={about.hero.eyebrow} title="A finance partner designed around" titleDim="the way modern businesses operate" text={about.hero.text} primary="Book a consultation" secondary="Our services" secondaryHref="/services">
    <div slot="below"><OverlapDiagram /></div>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div class="split__aside">
        <SectionIntro eyebrow="Who we are" title={about.story.title} tone="blue" />
        <div class="story__art" aria-hidden="true" data-reveal style="--i:1"><NetworkGraph /></div>
      </div>
      <div class="story" data-reveal>
        {about.story.paragraphs.map((p, i) => <p class:list={{ 'story__lead': i === 0 }}>{p}</p>)}
      </div>
    </div>
  </section>

  <WhyGrid eyebrow="What we stand for" heading="Transparency, integrity and trust are the cornerstones of our practice." items={[
    { title: 'Ethical standards', text: 'Every recommendation we make is in your best interest.', icon: 'ph:scales-duotone' },
    { title: 'Open communication', text: 'The information and insight you need to decide with confidence.', icon: 'ph:chats-circle-duotone' },
    { title: 'Lasting relationships', text: 'Trusted advisers, not just accountants, at every step.', icon: 'ph:handshake-duotone' },
  ]} />

  <section class="section">
    <div class="container split">
      <div class="split__aside"><SectionIntro eyebrow="Our approach" title={about.approach.title} lede="Four words we hold ourselves to on every engagement." tone="blue" /></div>
      <LedgerList large items={about.approach.items.map((a) => ({ title: a.title, text: a.text }))} />
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <SectionHeader eyebrow="Why clients engage us" title={about.why.title} text="The three reasons businesses bring us in, and what changes for them." />
      <div class="why">
        {about.why.items.map((w, i) => (
          <div class="why__item" data-reveal style={`--i:${i}`}>
            <span class="ring ring--blue"><Icon name={whyIcons[i]} /></span>
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {showLeadership && (
    <section class="section">
      <div class="container">
        <SectionHeader eyebrow="Leadership" title={about.leadership.title} />
        <div class="grid grid--3">
          {about.leadership.people.map((p) => (
            <div class="person" data-reveal>
              {p.photo && <img src={p.photo} alt={p.name} width="96" height="96" />}
              <h4>{p.name}</h4><p class="small" style="color: var(--blue); font-weight: 600">{p.role}</p><p class="small muted">{p.bio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  .story__art { margin-top: 32px; max-width: 360px; opacity: .8; }
  .story p { color: var(--graphite); font-size: 16.5px; line-height: 1.7; }
  .story p + p { margin-top: 18px; }
  .story__lead { font-family: var(--font-display); font-weight: 600; font-size: 24px !important; line-height: 1.3 !important; letter-spacing: -0.02em; color: var(--ink) !important; }
  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .why__item { padding: 28px; border-radius: var(--r-panel); background: var(--surface-elevated); box-shadow: var(--shadow-subtle-2); }
  .why__item h3 { margin-top: 20px; }
  .why__item p { margin-top: 10px; }
  .person { padding: 24px; border-radius: var(--r-panel); background: var(--surface-base); }
  .person img { border-radius: 12px; margin-bottom: 14px; }
  @media (max-width: 760px) { .why { grid-template-columns: 1fr; } }
</style>
