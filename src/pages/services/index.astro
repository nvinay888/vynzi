---
/* Services overview, v5 (blueprint slide 5): the four practices sit in the hero panel, so they are the first thing
   a visitor sees; the problem-led selector is one side-tab explorer; then the CTA. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SideTabs from '../../components/SideTabs.astro';
import PracticeCard from '../../components/PracticeCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { overview, practices } from '../../content/services';
import { practices as meta } from '../../data/site';
const byId = (slug: string) => practices.find((p) => p.slug === slug)!;
const oneLiner = (slug: string) => meta.find((m) => m.slug === slug)?.oneLiner ?? '';
const probIcons: Record<string, string> = { Growth: 'ph:trend-up-duotone', Visibility: 'ph:eye-duotone', Control: 'ph:shield-check-duotone', Automation: 'ph:lightning-duotone', 'ESG readiness': 'ph:leaf-duotone' };
const tabs = overview.selector.problems.map((p) => ({ label: p.label, sub: p.practices.map((s) => byId(s).short).join(' · '), icon: probIcons[p.label] }));
---
<BaseLayout title="Services" description={overview.hero.text}>
  <PageHero eyebrow={overview.hero.eyebrow} title="Finance, technology and ESG services" titleDim="for growing companies" text={overview.hero.text}>
    <div slot="below" class="pgrid m-swipe">
      {meta.map((m, i) => { const p = byId(m.slug); return <PracticeCard href={`/services/${p.slug}`} icon={p.icon} title={p.name} text={m.oneLiner} verbs={p.eyebrow} accent={p.accent} variant="elevated" index={i} />; })}
    </div>
  </PageHero>

  <section class="section" id="selector">
    <div class="container">
      <SectionHeader eyebrow="Problem-led selector" title={overview.selector.title} text={overview.selector.intro} />
      <SideTabs tabs={tabs} id="problems" label="Situations">
        {overview.selector.problems.map((p) => (
          <div data-panel data-slug={p.key}>
            <div class="ph"><span class="ring ring--blue"><Icon name={probIcons[p.label]} /></span><h3>{p.label}</h3></div>
            <p class="lead">{p.text}</p>
            <p class="eyebrow by">Resolved by</p>
            <div class="res">
              {p.practices.map((slug) => { const pr = byId(slug); return (
                <a href={`/services/${slug}`} class="res__card">
                  <span class:list={['ring', 'ring--sm', pr.accent === 'teal' ? 'ring--teal' : 'ring--blue']}><Icon name={pr.icon} /></span>
                  <strong>{pr.name}</strong>
                  <span>{oneLiner(slug)}</span>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              ); })}
            </div>
          </div>
        ))}
      </SideTabs>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .pgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .ph { display: flex; align-items: center; gap: 14px; }
  .ph h3 { font-size: clamp(24px, 2.4vw, 30px); }
  .lead { margin-top: 18px; font-size: 18px; line-height: 1.55; font-weight: 500; color: var(--ink-72); max-width: 52ch; }
  .by { margin-top: 28px; }
  .res { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 12px; }
  .res__card { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 20px; border-radius: 14px; background: var(--surface); box-shadow: rgba(11,31,77,.08) 0 0 0 1px; color: inherit; transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .res__card:hover { transform: translateY(-2px); box-shadow: var(--shadow-float); }
  .res__card strong { font-family: var(--font-display); font-weight: 500; font-size: 19px; letter-spacing: -0.01em; color: var(--ink); }
  .res__card span:not(.ring) { font-size: 14px; color: var(--slate); }
  .res__card svg { position: absolute; top: 22px; right: 20px; width: 16px; height: 16px; color: var(--stone); transition: transform var(--dur-fast), color var(--dur-fast); }
  .res__card:hover svg { color: var(--blue); transform: translateX(3px); }
  @media (max-width: 960px) { .pgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .pgrid, .res { grid-template-columns: 1fr; } }
</style>
