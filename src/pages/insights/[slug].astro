---
/* Article page: Panxo split hero (title left, summary + meta right), then a reading column with a sticky practice card.
   Every piece ends with its practice's CTA (blueprint slide 12). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { insights } from '../../content/insights';
import { practices } from '../../content/services';

export function getStaticPaths() {
  return insights.articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article: a } = Astro.props;
const practice = practices.find((p) => p.slug === a.practice);
const type = insights.types.find((t) => t.key === a.type);
const related = insights.articles.filter((x) => x.slug !== a.slug && (x.practice === a.practice || x.type === a.type)).slice(0, 3);
---
<BaseLayout title={a.title} description={a.summary}>
  <PageHero eyebrow={type?.label} title={a.title} text={a.summary} compact>
    <div slot="aside" class="meta">
      {practice && <Badge tone={practice.accent}>{practice.name}</Badge>}
      <span>{a.date}</span>
      {a.readTime && <span>{a.readTime} read</span>}
    </div>
  </PageHero>

  <section class="section">
    <div class="container read">
      <article class="read__body">
        <a href={`/insights#${a.type}`} class="arrow back"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>All {type?.label.toLowerCase()}</a>
        {(a.body ?? []).map((p, i) => <p class:list={{ first: i === 0 }}>{p}</p>)}
      </article>
      {practice && (
        <aside class="read__aside">
          <div class="pc">
            <span class="ring ring--blue"><Icon name={practice.icon} /></span>
            <p class="eyebrow">Related practice</p>
            <h3>{practice.name}</h3>
            <p class="small muted">{practice.hero.text}</p>
            <Button href={`/services/${practice.slug}`} variant="white">About this practice</Button>
            <Button href="/contact" variant="primary">{practice.cta.primary}</Button>
          </div>
        </aside>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section band">
      <div class="container">
        <p class="eyebrow" style="margin-bottom: 20px">Related reading</p>
        <div class="related">
          {related.map((r) => <a href={`/insights/${r.slug}`} class="rel"><span class="small muted">{insights.types.find((t) => t.key === r.type)?.label} · {r.readTime} read</span><strong>{r.title}</strong><span class="small muted">{r.summary}</span></a>)}
        </div>
      </div>
    </section>
  )}

  {practice ? (
    <CtaBand title={practice.cta.title} text={practice.cta.text} primary={practice.cta.primary} secondary="All insights" secondaryHref="/insights" />
  ) : (
    <CtaBand secondary="All insights" secondaryHref="/insights" />
  )}
</BaseLayout>

<style>
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; font-size: 13px; color: var(--stone); }
  .read { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .read__body { max-width: 680px; }
  .back { font-size: 14px; color: var(--blue); margin-bottom: 28px; }
  .read__body p { color: var(--graphite); font-size: 17px; line-height: 1.75; }
  .read__body p + p { margin-top: 20px; }
  .read__body p.first { font-size: 19px; line-height: 1.65; color: var(--ink); }
  .read__aside { position: sticky; top: 96px; }
  .pc { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px; border-radius: var(--r-panel); background: var(--surface-elevated); box-shadow: var(--shadow-subtle-2); }
  .pc h3 { font-size: 20px; }
  .pc :global(.btn) { width: 100%; }
  .related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .rel { display: flex; flex-direction: column; gap: 8px; padding: 22px; border-radius: var(--r-panel); background: var(--surface-elevated); box-shadow: var(--shadow-subtle-2); color: var(--ink); transition: transform var(--dur) var(--ease-out); }
  .rel:hover { transform: translateY(-2px); }
  .rel strong { font-weight: 600; font-size: 16px; line-height: 1.3; }
  @media (max-width: 900px) { .read { grid-template-columns: 1fr; } .read__aside { position: static; } .related { grid-template-columns: 1fr; } }
</style>
