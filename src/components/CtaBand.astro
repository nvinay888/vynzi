---
import Button from './Button.astro';
import NetworkGraph from './art/NetworkGraph.astro';
interface Props { title?: string; text?: string; primary?: string; primaryHref?: string; secondary?: string; secondaryHref?: string }
const {
  title = 'Book a confidential consultation',
  text = 'Tell us what you are trying to improve. We will help identify where VynziCFO can add value.',
  primary = 'Book a consultation', primaryHref = '/contact', secondary, secondaryHref,
} = Astro.props;
---
<section class="section section--tight">
  <div class="container">
    <div class="cta" data-reveal>
      <div class="cta__art" aria-hidden="true"><NetworkGraph variant="dark" /></div>
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="cta__body">
        <p class="eyebrow cta__eyebrow">Next step</p>
        <h2 class="cta__title">{title}</h2>
        <p class="cta__text">{text}</p>
        <div class="cta__actions">
          <Button href={primaryHref} variant="gold" size="lg" icon>{primary}</Button>
          {secondary && <a href={secondaryHref} class="arrow cta__alt">{secondary}<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; padding: clamp(36px, 6vw, 72px); border-radius: 22px; background: var(--gradient-dark-card); color: #fff; }
  .cta__art { position: absolute; right: -40px; top: -30px; width: 56%; opacity: .7; pointer-events: none; }
  .cta__glow { position: absolute; left: -10%; bottom: -60%; width: 60%; height: 140%; background: radial-gradient(closest-side, rgba(47,111,237,.5), rgba(15,157,138,.2) 55%, transparent 75%); filter: blur(10px); pointer-events: none; }
  .cta__body { position: relative; max-width: 560px; }
  .cta__eyebrow { color: var(--gold); }
  .cta__title { margin-top: 12px; color: #fff; font-size: clamp(30px, 4vw, 44px); letter-spacing: -0.035em; }
  .cta__text { margin-top: 14px; color: rgba(255,255,255,.76); font-size: 17px; max-width: 48ch; }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px; }
  .cta__alt { color: rgba(255,255,255,.85); font-size: 15px; }
  .cta__alt:hover { color: #fff; }
  @media (max-width: 760px) { .cta__art { width: 90%; opacity: .35; } }
</style>
