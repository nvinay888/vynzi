---
/* About hero visual: the four disciplines as overlapping circles with VynziCFO at the centre (the "always overlap"
   statement drawn), beside a card listing the expertise behind each. */
import { Icon } from 'astro-icon/components';
const circles = [
  { label: 'Finance', cx: 160, cy: 150, color: '#2f6fed' },
  { label: 'Data', cx: 260, cy: 150, color: '#7c9cf5' },
  { label: 'Technology', cx: 160, cy: 250, color: '#0b1f4d' },
  { label: 'Sustainability', cx: 260, cy: 250, color: '#14b8a0' },
];
const expertise = [
  { t: 'CFO and strategic finance', d: 'Planning, forecasting, board and investor support', i: 'ph:compass-duotone' },
  { t: 'Accounting and finance operations', d: 'Close, reconciliations, payroll, audit support', i: 'ph:stack-duotone' },
  { t: 'Analytics and reporting', d: 'KPIs, management packs, dashboards', i: 'ph:chart-line-up-duotone' },
  { t: 'Finance technology and automation', d: 'ERP, integration, workflow automation', i: 'ph:flow-arrow-duotone' },
  { t: 'Sustainability and ESG', d: 'Strategy, data, BRSR and GRI reporting', i: 'ph:leaf-duotone' },
];
---
<div class="ov">
  <div class="ov__card ov__venn" data-reveal>
    <svg viewBox="0 0 420 400" role="img" aria-label="Finance, data, technology and sustainability overlapping, with VynziCFO at the centre">
      {circles.map((c, i) => (
        <g class="ov__c" style={`--i:${i}`}>
          <circle cx={c.cx} cy={c.cy} r="92" fill={c.color} fill-opacity=".12" stroke={c.color} stroke-opacity=".55" stroke-width="1.5" />
        </g>
      ))}
      <text x="96" y="92" class="ov__t">Finance</text>
      <text x="300" y="92" class="ov__t" text-anchor="end" dx="24">Data</text>
      <text x="80" y="330" class="ov__t">Technology</text>
      <text x="330" y="330" class="ov__t" text-anchor="end" dx="20">Sustainability</text>
      <g class="ov__core">
        <rect x="160" y="182" width="100" height="36" rx="18" fill="#002058" />
        <text x="210" y="205" text-anchor="middle" class="ov__core-t">VynziCFO</text>
      </g>
    </svg>
  </div>
  <div class="ov__card ov__list" data-reveal style="--i:1">
    <p class="ov__label">One team across</p>
    <ul>
      {expertise.map((e) => <li><span class="ring ring--sm ring--blue"><Icon name={e.i} /></span><div><strong>{e.t}</strong><span>{e.d}</span></div></li>)}
    </ul>
  </div>
</div>

<style>
  .ov { display: grid; grid-template-columns: 1fr 1.1fr; gap: 16px; }
  .ov__card { background: #fff; border-radius: 16px; box-shadow: var(--shadow-float); }
  .ov__venn { display: flex; align-items: center; justify-content: center; padding: 16px; }
  .ov__venn svg { width: 100%; max-width: 420px; height: auto; }
  .ov__c { transform-box: fill-box; transform-origin: center; animation: breathe 7s ease-in-out infinite; animation-delay: calc(var(--i) * -1.6s); }
  .ov__t { font-family: Inter, sans-serif; font-size: 14px; font-weight: 600; fill: #0b1f4d; }
  .ov__core-t { font-family: 'Mona Sans', Inter, sans-serif; font-size: 14px; font-weight: 600; fill: #fff; }
  .ov__core { animation: pulse 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .ov__list { padding: 24px 26px; }
  .ov__label { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--stone); }
  .ov__list ul { margin-top: 10px; }
  .ov__list li { display: flex; gap: 14px; align-items: center; padding: 12px 0; border-bottom: 1px dashed var(--ash); }
  .ov__list li:last-child { border-bottom: 0; }
  .ov__list strong { display: block; font-size: 14.5px; font-weight: 600; color: var(--ink); }
  .ov__list span:not(.ring) { display: block; font-size: 13px; color: var(--slate); margin-top: 2px; }
  @keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04); } }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  @media (max-width: 860px) { .ov { grid-template-columns: 1fr; } }
</style>
