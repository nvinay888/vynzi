---
/* Panxo category badge: surface fill, no border, 6px radius. Tone adds a quiet tint for ESG/finance taxonomy. */
interface Props { tone?: 'neutral' | 'blue' | 'teal' | 'gold'; class?: string }
const { tone = 'neutral', class: cls = '' } = Astro.props;
---
<span class:list={['badge', `badge--${tone}`, cls]}><slot /></span>

<style>
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: var(--r-badge);
    font-size: 12px; font-weight: 500; line-height: 1.3; letter-spacing: 0.01em;
    background: var(--surface-base); color: var(--graphite);
  }
  .badge--blue { background: var(--blue-soft); color: #1f4fb8; }
  .badge--teal { background: var(--teal-soft); color: #0b7a6b; }
  .badge--gold { background: #fdf3cf; color: #7a5a00; }
</style>
