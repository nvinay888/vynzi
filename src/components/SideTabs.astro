---
/* Side-tab explorer: replaces stacks of long sections with one compact panel.
   Desktop: vertical tab list left, panel right. Mobile: a swipeable tab bar on top, panel below.
   Panels are the direct children of the default slot (`<div data-panel>…</div>`), in the same order as `tabs`.
   Each panel ends with previous / next links so the sequence still reads as a story on a phone.
   Without JavaScript every panel is shown in order. */
import { Icon } from 'astro-icon/components';
interface Tab { label: string; sub?: string; icon?: string }
interface Props { tabs: Tab[]; id: string; label?: string; tone?: 'blue' | 'teal'; aside?: boolean }
const { tabs, id, label = 'Sections', tone = 'blue', aside = false } = Astro.props;
---
<div class:list={['st', `st--${tone}`]} data-sidetabs id={id}>
  <div class="st__rail">
    {Astro.slots.has('rail') && <div class="st__railhead"><slot name="rail" /></div>}
    <div class="st__list" role="tablist" aria-label={label} aria-orientation="vertical">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class:list={['st__tab', { 'is-on': i === 0 }]}>
          {t.icon && <span class="st__icon"><Icon name={t.icon} /></span>}
          <span class="st__text"><strong>{t.label}</strong>{t.sub && <small>{t.sub}</small>}</span>
          <svg class="st__chev" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      ))}
    </div>
    {aside && <div class="st__railfoot"><slot name="railfoot" /></div>}
  </div>
  <div class="st__panels" data-labels={JSON.stringify(tabs.map((t) => t.label))}>
    <slot />
    <nav class="st__pager" aria-label="Section navigation">
      <button type="button" class="st__prev"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg><span></span></button>
      <span class="st__count"></span>
      <button type="button" class="st__next"><span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button>
    </nav>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sidetabs]').forEach((root) => {
    const id = root.id;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(':scope > .st__rail [role=tab]')];
    const wrap = root.querySelector<HTMLElement>(':scope > .st__panels')!;
    const panels = [...wrap.querySelectorAll<HTMLElement>(':scope > [data-panel]')];
    const labels: string[] = JSON.parse(wrap.dataset.labels || '[]');
    const prev = wrap.querySelector<HTMLButtonElement>('.st__prev')!;
    const next = wrap.querySelector<HTMLButtonElement>('.st__next')!;
    const count = wrap.querySelector<HTMLElement>('.st__count')!;
    root.classList.add('is-js');
    panels.forEach((p, i) => { p.id = `${id}-panel-${i}`; p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', `${id}-tab-${i}`); p.tabIndex = 0; });
    let cur = 0;
    const select = (n: number, focus = false, scroll = false) => {
      cur = (n + tabs.length) % tabs.length;
      tabs.forEach((t, i) => { const on = i === cur; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      panels.forEach((p, i) => { p.hidden = i !== cur; });
      prev.hidden = cur === 0; next.hidden = cur === tabs.length - 1;
      (prev.querySelector('span') as HTMLElement).textContent = labels[cur - 1] ?? '';
      (next.querySelector('span') as HTMLElement).textContent = labels[cur + 1] ?? '';
      count.textContent = `${cur + 1} / ${tabs.length}`;
      tabs[cur].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (focus) tabs[cur].focus();
      if (scroll && root.getBoundingClientRect().top < 0) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (['ArrowDown', 'ArrowRight'].includes(k)) { e.preventDefault(); select(cur + 1, true); }
        if (['ArrowUp', 'ArrowLeft'].includes(k)) { e.preventDefault(); select(cur - 1, true); }
        if (k === 'Home') { e.preventDefault(); select(0, true); }
        if (k === 'End') { e.preventDefault(); select(tabs.length - 1, true); }
      });
    });
    prev.addEventListener('click', () => select(cur - 1, false, true));
    next.addEventListener('click', () => select(cur + 1, false, true));
    // Deep link: #<id>-<n> or a hash matching a panel's data-slug opens that tab.
    const fromHash = () => {
      const h = location.hash.slice(1); if (!h) return;
      const bySlug = panels.findIndex((p) => p.dataset.slug === h);
      if (bySlug >= 0) { select(bySlug); root.scrollIntoView({ block: 'start' }); }
    };
    select(0); fromHash(); addEventListener('hashchange', fromHash);
  });
</script>

<style>
  .st { display: grid; grid-template-columns: 300px minmax(0, 1fr); border-radius: var(--r-hero); background: var(--surface-elevated); box-shadow: var(--shadow-subtle-2); overflow: clip; scroll-margin-top: 90px; }
  .st__rail { min-width: 0; }
  .st__rail { display: flex; flex-direction: column; gap: 12px; padding: 14px; background: var(--surface); border-right: 1px solid var(--ash); }
  .st__railhead { padding: 10px 10px 4px; }
  .st__railfoot { margin-top: auto; padding: 10px; }
  .st__list { display: flex; flex-direction: column; gap: 4px; }
  .st__tab { position: relative; width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 12px 12px; border-radius: 12px; text-align: left; color: var(--slate); transition: background var(--dur-fast), color var(--dur-fast), box-shadow var(--dur-fast); }
  .st__tab:not(:has(.st__icon)) { grid-template-columns: 1fr auto; }
  .st__tab:hover { background: var(--surface-elevated); color: var(--ink); }
  .st__tab.is-on { background: var(--surface-elevated); color: var(--ink); box-shadow: var(--shadow-subtle-2); }
  .st__icon { display: inline-flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 10px; background: var(--surface-base); color: var(--stone); flex: none; transition: all var(--dur-fast); }
  .st__icon :global(svg) { width: 19px; height: 19px; }
  .st__tab.is-on .st__icon { background: var(--blue-soft); color: var(--blue); }
  .st--teal .st__tab.is-on .st__icon { background: var(--teal-soft); color: var(--teal); }
  .st__text strong { display: block; font-size: 14.5px; font-weight: 600; line-height: 1.3; }
  .st__text small { display: block; margin-top: 2px; font-size: 12.5px; line-height: 1.35; color: var(--stone); }
  .st__chev { width: 16px; height: 16px; opacity: 0; transition: opacity var(--dur-fast), transform var(--dur-fast); }
  .st__tab.is-on .st__chev { opacity: .6; }
  .st__panels { position: relative; min-width: 0; padding: clamp(24px, 3.4vw, 44px); display: flex; flex-direction: column; }
  .st__panels > :global([data-panel]) { outline: none; }
  .st.is-js .st__panels > :global([data-panel]:not([hidden])) { animation: stfade .35s var(--ease-out); flex: 1; }
  .st:not(.is-js) .st__panels > :global([data-panel] + [data-panel]) { margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--ash); }
  .st__pager { display: none; }
  .st.is-js .st__pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 32px; padding-top: 18px; border-top: 1px solid var(--ash); }
  .st__pager button { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; color: var(--ink); max-width: 45%; text-align: left; }
  .st__pager button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st__pager button:hover { color: var(--blue); }
  .st__pager button svg { width: 16px; height: 16px; flex: none; }
  .st__pager button[hidden] { visibility: hidden; display: inline-flex; }
  .st__next { margin-left: auto; text-align: right; }
  .st__count { font-size: 12px; font-family: var(--font-mono); color: var(--stone); }
  @keyframes stfade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  @media (max-width: 900px) {
    .st { grid-template-columns: minmax(0, 1fr); }
    .st__rail { padding: 10px; gap: 6px; border-right: 0; border-bottom: 1px solid var(--ash); position: sticky; top: 68px; z-index: 5; }
    .st__railhead, .st__railfoot { display: none; }
    .st__list { flex-direction: row; overflow-x: auto; scroll-snap-type: x proximity; gap: 6px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .st__list::-webkit-scrollbar { display: none; }
    .st__tab { width: auto; flex: none; grid-template-columns: auto auto; padding: 9px 14px 9px 10px; border-radius: 999px; scroll-snap-align: start; white-space: nowrap; }
    .st__tab:not(:has(.st__icon)) { grid-template-columns: auto; padding: 9px 16px; }
    .st__icon { width: 26px; height: 26px; border-radius: 8px; }
    .st__icon :global(svg) { width: 16px; height: 16px; }
    .st__text small, .st__chev { display: none; }
    .st__text strong { font-size: 14px; }
    .st__panels { padding: 22px 18px; }
  }
</style>
