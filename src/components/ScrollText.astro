---
/* Panxo signature: a long statement whose words light up as the reader scrolls through it.
   `dark` sets it on the navy band. `accent` names one phrase inside `text` that is set in Title Case and golden
   yellow ("Finance, Data, Technology and Sustainability"); the rest of the sentence stays as written.
   Gold sits on navy because gold on the light page fails contrast (≈1.6:1 vs ≈9:1). */
interface Props { text: string; dark?: boolean; accent?: string }
const { text, dark = false, accent } = Astro.props;
const minor = new Set(['a', 'an', 'and', 'as', 'at', 'but', 'by', 'for', 'in', 'nor', 'of', 'on', 'or', 'the', 'to', 'via', 'with']);
const toTitle = (s: string) => s.split(' ').map((w, i) => {
  const bare = w.toLowerCase().replace(/[^a-z]/g, '');
  if (i > 0 && minor.has(bare)) return w.toLowerCase();
  return w.charAt(0).toUpperCase() + w.slice(1);
}).join(' ');
const at = accent ? text.toLowerCase().indexOf(accent.toLowerCase()) : -1;
const parts = at >= 0
  ? [{ s: text.slice(0, at), a: false }, { s: toTitle(text.slice(at, at + accent!.length)), a: true }, { s: text.slice(at + accent!.length), a: false }]
  : [{ s: text, a: false }];
const words = parts.flatMap((p) => p.s.split(' ').filter(Boolean).map((w) => ({ w, a: p.a })));
---
<section class:list={['section', 'st', { 'st--dark': dark }]} data-scrolltext>
  <div class="container">
    <p class="st__text">
      {words.map(({ w, a }) => <span class:list={['st__w', { 'st__w--accent': a }]}>{w} </span>)}
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-scrolltext]').forEach((root) => {
    const words = [...root.querySelectorAll<HTMLElement>('.st__w')];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { words.forEach((w) => w.classList.add('on')); return; }
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const vh = innerHeight;
      const start = vh * 0.8, end = vh * 0.45;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.6)));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle('on', i < lit));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); update();
  });
</script>

<style>
  .st__text { max-width: 32ch; margin: 0 auto; font-family: var(--font-display); font-weight: 500; font-size: clamp(26px, 3vw, 40px); line-height: 1.25; letter-spacing: -0.01em; }
  .st__w { color: rgba(11, 31, 77, 0.2); transition: color .35s ease; }
  .st__w.on { color: var(--ink); }
  .st--dark { position: relative; overflow: hidden; background: var(--ink-fill); }
  .st--dark::before { content: ''; position: absolute; inset: -40% -10% auto auto; width: 60%; height: 140%; background: radial-gradient(closest-side, rgba(47,111,237,.35), transparent 70%); pointer-events: none; }
  .st--dark .container { position: relative; }
  .st__w--accent.on { color: var(--gold-deep); }
  .st--dark .st__w { color: rgba(255, 255, 255, 0.2); }
  .st--dark .st__w.on { color: #fff; }
  .st--dark .st__w--accent { color: rgba(240, 192, 48, 0.28); }
  .st--dark .st__w--accent.on { color: var(--gold); }
  @media (min-width: 900px) { .st__text { max-width: 34ch; } }
</style>
