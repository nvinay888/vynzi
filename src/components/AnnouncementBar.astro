---
/* Panxo announcement bar: the one full-bleed dark strip above the nav. Content: the new ESG practice (blueprint slide 9).
   A ticker: the message scrolls continuously right to left, pauses on hover or keyboard focus, and the whole strip is one link.
   Two identical halves make the loop seamless; the copies are hidden from assistive tech. Static under reduced motion. */
const REPEAT = 4;
---
<a href="/services/sustainability-esg" class="ann" aria-label="New practice: Sustainability & ESG, from disclosure to management. See what is included.">
  <div class="ann__track" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="ann__half">
        {Array.from({ length: REPEAT }).map(() => (
          <span class="ann__item">
            <span class="ann__dot"></span>
            <span>New practice: <strong>Sustainability &amp; ESG</strong> — from disclosure to management.</span>
            <span class="ann__link">See what is included
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </span>
        ))}
      </div>
    ))}
  </div>
</a>

<style>
  .ann { display: block; position: relative; overflow: hidden; background: var(--ink-fill); color: rgba(255,255,255,.82); font-size: 13.5px; }
  .ann::before, .ann::after { content: ''; position: absolute; top: 0; bottom: 0; width: 64px; z-index: 1; pointer-events: none; }
  .ann::before { left: 0; background: linear-gradient(90deg, var(--ink-fill), transparent); }
  .ann::after { right: 0; background: linear-gradient(270deg, var(--ink-fill), transparent); }
  .ann__track { display: flex; width: max-content; animation: ticker 48s linear infinite; }
  .ann:hover .ann__track, .ann:focus-visible .ann__track { animation-play-state: paused; }
  .ann:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; border-radius: 0; }
  .ann__half { display: flex; flex: none; }
  .ann__item { display: inline-flex; align-items: center; gap: 12px; min-height: 38px; padding-right: 56px; white-space: nowrap; }
  .ann strong { color: #fff; font-weight: 600; }
  .ann__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal-bright); flex: none; animation: pulse 2.4s infinite; }
  .ann__link { display: inline-flex; align-items: center; gap: 6px; color: var(--gold); font-weight: 600; }
  .ann:hover .ann__link { text-decoration: underline; text-underline-offset: 3px; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(20,184,160,.55); } 70% { box-shadow: 0 0 0 8px rgba(20,184,160,0); } 100% { box-shadow: 0 0 0 0 rgba(20,184,160,0); } }
  @media (max-width: 600px) { .ann { font-size: 13px; } .ann__track { animation-duration: 36s; } }
  /* Reduced motion: one static, centred message. */
  @media (prefers-reduced-motion: reduce) {
    .ann__track { width: auto; justify-content: center; animation: none; }
    .ann__half + .ann__half, .ann__item + .ann__item { display: none; }
    .ann__item { padding: 0 16px; }
    .ann::before, .ann::after { display: none; }
  }
</style>
