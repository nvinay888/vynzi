---
/* Panxo announcement bar: the one full-bleed dark strip above the nav. Content: the new ESG practice (blueprint slide 9). */
---
<div class="ann">
  <div class="container ann__inner">
    <span class="ann__dot" aria-hidden="true"></span>
    <p><span class="ann__long">New practice: </span><strong>Sustainability &amp; ESG</strong><span class="ann__long"> — from disclosure to management.</span></p>
    <a href="/services/sustainability-esg" class="ann__link">See what is included
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</div>

<style>
  .ann { background: var(--ink-fill); color: rgba(255,255,255,.82); font-size: 13.5px; }
  .ann__inner { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 38px; flex-wrap: wrap; text-align: center; }
  .ann strong { color: #fff; font-weight: 600; }
  .ann__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal-bright); box-shadow: 0 0 0 0 rgba(20,184,160,.6); animation: pulse 2.4s infinite; }
  .ann__link { display: inline-flex; align-items: center; gap: 6px; color: var(--gold); font-weight: 600; }
  .ann__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(20,184,160,.55); } 70% { box-shadow: 0 0 0 8px rgba(20,184,160,0); } 100% { box-shadow: 0 0 0 0 rgba(20,184,160,0); } }
  @media (max-width: 600px) { .ann__inner { gap: 10px; font-size: 13px; flex-wrap: nowrap; } .ann__long { display: none; } .ann__dot { flex: none; } .ann p::before { content: 'New: '; } }
</style>
