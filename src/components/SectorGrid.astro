---
/* Sectors (blueprint block 2, "Trust: sectors"): one-row carousel of sector tiles (icon, name, what we provide),
   each opening that sector's tab on /industries. Swipe on mobile. */
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import Carousel from './Carousel.astro';
import { industries } from '../content/industries';
import { sectors as sectorMeta } from '../data/site';
const iconFor = (slug: string) => sectorMeta.find((s) => s.slug === slug)?.icon ?? 'ph:buildings-duotone';
---
<section class="section section--tight sectors">
  <div class="container">
    <SectionHeader eyebrow="Industries" title="Cross-sector experience," titleDim="applied to the right solution for your business" text="Seven industries where we already know the leading practices, the regulations and the numbers that matter, and the lessons that carry across them." action="All industries" actionHref="/industries" />
    <Carousel per={4} label="Sectors">
      {industries.sectors.map((s, i) => (
        <div>
          <a href={`/industries#${s.slug}`} class:list={['tile', { 'tile--muted': s.slug === 'other' }]}>
            <span class="ring ring--blue"><Icon name={iconFor(s.slug)} /></span>
            <span class="tile__body">
              <strong>{s.name}</strong>
              <span class="tile__text">{s.provide}</span>
            </span>
            <svg class="tile__arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </Carousel>
  </div>
</section>

<style>
  .sectors { background: var(--surface-elevated); border-bottom: 1px solid var(--ash); }
  .sectors__head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .sectors__all { white-space: nowrap; padding-bottom: 6px; }
  .sectors__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .tile { display: flex; flex-direction: column; gap: 16px; height: 100%; padding: 22px; border-radius: var(--r-panel); background: var(--surface); border: 1px solid var(--ash); color: var(--ink); position: relative; transition: transform var(--dur) var(--ease-out), box-shadow var(--dur), border-color var(--dur); }
  .tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-float); border-color: transparent; }
  .tile--muted { background: var(--surface-base); border-style: dashed; }
  .tile__body { display: flex; flex-direction: column; gap: 6px; }
  .tile strong { font-family: var(--font-display); font-weight: 500; font-size: 18px; letter-spacing: -0.015em; }
  .tile__text { font-size: 13.5px; line-height: 1.5; color: var(--slate); }
  .tile__arrow { position: absolute; top: 24px; right: 22px; width: 18px; height: 18px; color: var(--stone); opacity: 0; transform: translateX(-4px); transition: all var(--dur-fast); }
  .tile:hover .tile__arrow { opacity: 1; transform: none; color: var(--blue); }
  @media (max-width: 960px) { .sectors__grid { grid-template-columns: repeat(2, 1fr); } .sectors__head { flex-direction: column; align-items: flex-start; gap: 8px; } }
  @media (max-width: 520px) { .sectors__grid { grid-template-columns: 1fr; } }
</style>
