---
import { nav, site } from '../data/site';
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label={`${site.name} home`}>
      <img src="/img/logo.png" alt="Vynzi" width="130" height="44" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li class:list={['nav__item', { 'has-children': !!item.children }]}>
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) || (item.label === 'Services' && path.startsWith('/industries')) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>}
            </a>
            {item.children && (
              <div class="menu">
                <ul class="menu__side">
                  {item.extras?.map((x) => <li><a href={x.href} class:list={['menu__extra', { 'is-active': isActive(x.href) }]}><strong>{x.label}</strong><small>{x.note}</small></a></li>)}
                </ul>
                <ul class="menu__main">
                  {item.children.map((c) => (
                    <li><a href={c.href} class:list={['menu__item', { 'is-active': isActive(c.href) }]}>
                      <span class="ring ring--sm ring--blue"><Icon name={c.icon} /></span>
                      <span><strong>{c.label}</strong><small>{c.note}</small></span>
                    </a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__cta"><Button href="/contact" variant="primary">Book a consultation</Button></div>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><span></span><span></span><span></span></button>
  </div>

  <div id="mobile-menu" class="nav__mobile" hidden>
    <ul class="container">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="nav__mlink">{item.label}</a>
          {item.children && (
            <ul class="nav__msub">
              {item.children.map((c) => <li><a href={c.href} class="nav__msublink">{c.label}</a></li>)}
              {item.extras?.map((x) => <li><a href={x.href} class="nav__msublink">{x.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
      <li class="nav__mcta"><Button href="/contact" variant="primary" size="lg" icon>Book a consultation</Button></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
    document.body.classList.toggle('nav-open', !open);
  });
  // Shadow on scroll
  const nav = document.querySelector('.nav');
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll(); addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(250, 250, 250, 0.86); backdrop-filter: saturate(1.5) blur(12px); border-bottom: 1px solid transparent; transition: border-color var(--dur), background var(--dur); }
  .nav.is-scrolled { border-bottom-color: var(--ash); background: rgba(255, 255, 255, 0.9); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-6); height: 68px; }
  .nav__brand img { height: 38px; width: auto; }
  .nav__links > ul { display: flex; gap: 2px; }
  .nav__item { position: relative; }
  .nav__link { display: inline-flex; align-items: center; gap: 5px; padding: 8px 12px; border-radius: var(--r-ghost); font-size: 14px; font-weight: 500; color: var(--graphite); transition: color var(--dur-fast), background var(--dur-fast); }
  .nav__link:hover, .nav__link.is-active { color: var(--ink); background: var(--surface-base); }
  .menu { position: absolute; left: -8px; top: calc(100% + 10px); display: grid; grid-template-columns: 220px 320px; padding: 8px; background: var(--surface-elevated); border-radius: var(--r-panel); box-shadow: var(--shadow-float); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility var(--dur-fast); }
  .nav__item.has-children:hover .menu, .nav__item.has-children:focus-within .menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .menu__main { display: flex; flex-direction: column; gap: 2px; }
  .menu__item { display: flex; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 10px; color: var(--ink); transition: background var(--dur-fast); }
  .menu__item:hover, .menu__item.is-active { background: var(--surface-base); }
  .menu__item strong { display: block; font-size: 14px; font-weight: 600; }
  .menu__item small { display: block; font-size: 12px; color: var(--slate); margin-top: 2px; }
  .menu__side { display: flex; flex-direction: column; gap: 2px; padding: 6px 8px 6px 0; margin-right: 8px; border-right: 1px solid var(--ash); }
  .menu__extra { display: block; padding: 10px 12px; border-radius: 10px; transition: background var(--dur-fast); }
  .menu__extra:hover, .menu__extra.is-active { background: var(--surface-base); }
  .menu__extra strong { display: block; font-size: 14px; font-weight: 600; color: var(--ink); }
  .menu__extra small { display: block; font-size: 12px; color: var(--slate); margin-top: 2px; }
  .nav__toggle { display: none; flex-direction: column; gap: 5px; padding: 10px; border-radius: 8px; }
  .nav__toggle span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
  .nav__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .nav__mobile { display: none; border-top: 1px solid var(--ash); background: var(--surface-elevated); max-height: calc(100vh - 68px); overflow: auto; }
  .nav__mobile > ul { padding-top: 12px; padding-bottom: 24px; }
  .nav__mlink { display: block; padding: 12px 0; font-family: var(--font-display); font-weight: 500; font-size: 22px; letter-spacing: -0.02em; color: var(--ink); }
  .nav__msub { padding: 0 0 8px 14px; border-left: 2px solid var(--ash); margin-left: 2px; }
  .nav__msublink { display: block; padding: 8px 0; font-size: 15px; color: var(--graphite); }
  .nav__mcta { margin-top: 16px; }
  @media (max-width: 960px) { .nav__links, .nav__cta { display: none; } .nav__toggle { display: flex; } .nav__mobile:not([hidden]) { display: block; } }
</style>
